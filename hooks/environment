#!/bin/bash
set -euo pipefail

# Load plugin bash library
DIR="$(cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd)"
# shellcheck source=lib/plugin.bash
. "$DIR/../lib/plugin.bash"

# Preserve runtime references here so repository pre-command hooks can populate or
# replace their values before the plugin resolves them in post-command.
API_KEY=$(plugin_read_config API_KEY "")

# Export API key if provided
if [[ -n "$API_KEY" ]]; then
  export BUILDKITE_PLUGIN_CLAUDE_SUMMARIZE_API_KEY="$API_KEY"
fi
