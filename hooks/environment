#!/bin/bash
set -euo pipefail

# Load plugin bash library
DIR="$(cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd)"
# shellcheck source=lib/plugin.bash
. "$DIR/../lib/plugin.bash"

# Resolve only a simple runtime environment-variable reference such as $ANTHROPIC_API_KEY.
API_KEY=$(plugin_read_secret_config API_KEY ANTHROPIC_API_KEY)

# Export API key if provided
if [[ -n "$API_KEY" ]]; then
  export BUILDKITE_PLUGIN_CLAUDE_SUMMARIZE_API_KEY="$API_KEY"
fi
